      <layout class="QVBoxLayout" name="verticalLayout_tabOptions">
       <item>
        <widget class="QCheckBox" name="chkRunAsSystem">
         <property name="text">
          <string>Ejecutar como SYSTEM / Administrador (Silencioso, sin UAC)</string>
         </property>
         <property name="checked">
