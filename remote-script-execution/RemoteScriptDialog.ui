        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblSystemNote">
         <property name="text">
          <string>&lt;i&gt;Permite instalar programas, editar registro, cambiar configuración de red y matar procesos sin que el alumno reciba ninguna notificación ni ventana.&lt;/i&gt;</string>
