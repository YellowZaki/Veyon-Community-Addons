            <string>Argumentos de línea de comandos:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="txtScriptArguments">
           <property name="placeholderText">
            <string>Opcional: argumentos pasados al script (ej: -param valor /silent)</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
